# CodeCompass configuration (NFR-005). Copy to .env with `make init-env`, which replaces
# every __GENERATE__ with a random secret. Then set GEMINI_API_KEY.
# Values marked "dev placeholder" are for local use only. In production, use a secret manager.

# ── Models (LiteLLM model IDs; change provider by changing these) ────────────────────────
# Free key: https://aistudio.google.com/apikey  (README: "Get a free Gemini key")
GEMINI_API_KEY=
# Gemini 3.6+ and 3.5-flash-lite reject `temperature`, which the app always sends; use models
# that accept it. Main answer model.
LLM_MODEL=gemini/gemini-3.1-flash-lite
# Fast model: follow-up rewrite, NeMo self-check, starter questions.
LLM_FAST_MODEL=gemini/gemini-3.1-flash-lite
# Eval judge (RAGAS). Can point at a different provider than LLM_MODEL.
LLM_JUDGE_MODEL=gemini/gemini-3.5-flash
# Local embeddings via the compose `ollama` service (no API quota used). To use Gemini instead:
# EMBEDDING_MODEL=gemini/gemini-embedding-001 and EMBED_TOKENS_PER_MINUTE=24000.
EMBEDDING_MODEL=ollama/nomic-embed-512
# Changing the dimension needs a new migration and a re-ingest of every codebase.
EMBEDDING_DIM=768

# ── App ──────────────────────────────────────────────────────────────────────────────────
# Local development URL. docker compose overrides it for the app container.
DATABASE_URL=postgresql+psycopg://postgres:__SAME_AS:POSTGRES_PASSWORD__@localhost:55432/codecompass
# Temporary extraction directory for downloads/uploads (always cleaned up).
DATA_DIR=/tmp/codecompass
# Ingestion limits (NFR-004, FR-003, FR-005).
MAX_FILES=5000
MAX_INDEX_BYTES=50000000
MAX_FILE_BYTES=524288
MAX_DOWNLOAD_BYTES=200000000
MAX_UPLOAD_BYTES=200000000
MAX_ARCHIVE_ENTRIES=100000
MAX_UNCOMPRESSED_BYTES=1000000000
# Small batches keep each local (CPU) embedding request short; use 64 for hosted models.
EMBED_BATCH_SIZE=8
# Embedding pace (NFR-004). 0 disables pacing (local Ollama, paid keys). Gemini free tier allows
# 30,000 embed tokens/min; use 24000 there to leave headroom for estimate error. 429s are waited out and retried.
EMBED_TOKENS_PER_MINUTE=0
EMBED_RATE_LIMIT_RETRIES=5
# Retrieval and context (research R6, R7). RETRIEVAL_MIN_SCORE is calibrated by `make eval` (T130).
RETRIEVAL_TOP_K=20
CONTEXT_MAX_CHUNKS=8
CONTEXT_MAX_TOKENS=6000
RETRIEVAL_MIN_SCORE=0.35
# GitHub (FR-001). Token is optional and only raises rate limits; public repos only.
GITHUB_API_BASE=https://api.github.com
GITHUB_TOKEN=
# Built frontend served by the API (the Dockerfile copies frontend/dist here).
STATIC_DIR=/app/static
# Shown in the UI when the LLM key is missing or invalid (NFR-007). Set this to the published
# repository's README anchor "#get-a-free-gemini-key". When empty, the UI names the README section.
LLM_HELP_URL=

# ── Langfuse, app side (FR-040, FR-041, FR-043) ─────────────────────────────────────────
LANGFUSE_ENABLED=true
# Local development URL. docker compose overrides it with http://langfuse-web:3000.
LANGFUSE_HOST=http://localhost:3000
# Browser-facing URL for "Open in Langfuse" links.
LANGFUSE_UI_URL=http://localhost:3000
# Project for "Open in Langfuse" links; docker compose passes LANGFUSE_INIT_PROJECT_ID.
LANGFUSE_PROJECT_ID=
# docker compose passes LANGFUSE_INIT_PROJECT_PUBLIC_KEY/SECRET_KEY below to the app, so the
# keys always match the project Langfuse creates at startup.

# ── Langfuse server, headless init (dev placeholders) ───────────────────────────────────
LANGFUSE_INIT_ORG_ID=codecompass
LANGFUSE_INIT_ORG_NAME=CodeCompass
LANGFUSE_INIT_PROJECT_ID=codecompass
LANGFUSE_INIT_PROJECT_NAME=CodeCompass
LANGFUSE_INIT_PROJECT_PUBLIC_KEY=pk-lf-__GENERATE__
LANGFUSE_INIT_PROJECT_SECRET_KEY=sk-lf-__GENERATE__
LANGFUSE_INIT_USER_EMAIL=admin@codecompass.local
LANGFUSE_INIT_USER_NAME=admin
LANGFUSE_INIT_USER_PASSWORD=__GENERATE__
NEXTAUTH_SECRET=__GENERATE__
SALT=__GENERATE__
# Must be 64 hex characters (init-env generates exactly that).
ENCRYPTION_KEY=__GENERATE__
TELEMETRY_ENABLED=false

# ── Infrastructure credentials (dev placeholders) ───────────────────────────────────────
# Host port for local development access to Postgres (compose maps it to 5432 inside).
POSTGRES_HOST_PORT=55432
POSTGRES_PASSWORD=__GENERATE__
CLICKHOUSE_PASSWORD=__GENERATE__
REDIS_AUTH=__GENERATE__
MINIO_ROOT_PASSWORD=__GENERATE__
